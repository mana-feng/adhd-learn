# Published: the lesson HTML folders, assets/, maintenance/, docs/deliveries,
# docs/superpowers and the root pages. Everything ignored below is based on
# the folders and files that actually exist in this working tree.

# output/ - 54k local run-evidence files (json/html/py/pyc/jpg/png/diff/md)
/output/

# examples/ - 8.8k full lab files (py/pyc/json/txt/zip). Only the two scripts
# used by the Mendix lessons are published.
/examples/*
!/examples/mendix/
/examples/mendix/*
!/examples/mendix/asset-service.py
!/examples/mendix/normalize-title.mjs

# _src/ - 675 maintenance copies (recovered_html/, vendor/, __pycache__/).
# 594 real maintenance sources are force-added and remain tracked.
/_src/

# docs/reports/ - 98 local audit reports; the rest of docs/ is published.
/docs/reports/

# Two local-only helper files
/scripts/package_examples.py
/.github/workflows/knowledge-lab.yml

# .workbuddy/memory/ - dated session logs. MEMORY.md and any rule/spec/plan
# stay versionable (AGENTS.md).
/.workbuddy/memory/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9].md

# Short-lived inspection pages written beside lesson HTML
__*tmp*.html

# Kept from the original file (none of these paths exist today): caches,
# temp/OS leftovers and credential safety.
__pycache__/
*.py[cod]
*.db*
*.sqlite*
.cache/
.runtime/
watch_store/

# Python/JS working dirs used by local runs
.venv/
venv/
node_modules/

# Temporary, backup, OS and editor leftovers
*.bak
*.tmp
*.log
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
.claude/

# Credentials and private keys are never part of the published site
.env
.env.*
!.env.example
*.pem
*.key
secrets.*
/.ssh/
.aws/
/id_*
*.p12
*.pfx
/credentials.json

# Old root-level local notes (new notes live under output/)
/CONTENT_DESIGN_*.md
/RAG_MCP_AGENT_*.md
/READING_LAYOUT_*.md
/CROSS_BOARD_READING_PILOT_2026-09-06.md
/CLAUDE.md
/.learnings/
