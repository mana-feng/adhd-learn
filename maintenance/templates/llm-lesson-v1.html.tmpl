<script>(function(){
  var KEY="overview-progress", FILE="";
  var memoryProgress=null;
  function storageNotice(message){var n=document.querySelector('.llm-storage-status');if(n)n.textContent=message;}
  function load(){if(memoryProgress!==null)return memoryProgress;try{var p=JSON.parse(localStorage.getItem(KEY));memoryProgress=p&&typeof p==='object'&&!Array.isArray(p)?p:{};}catch(e){memoryProgress={};storageNotice('无法读取浏览器存储；当前页打卡仅本次有效。');}return memoryProgress;}
  function refresh(){var d=!!load()[FILE];
    document.querySelectorAll('.js-done-btn').forEach(function(b){b.classList.toggle('done',d);
      b.textContent=d?(b.dataset.long?'✅ 已完成本章（点击撤销）':'✅ 已完成')
                     :(b.dataset.long?'完成了？点这里打卡 ✔':'☐ 打卡');});}
  document.querySelectorAll('.js-done-btn').forEach(function(b){b.addEventListener('click',function(){
    var p=load(); if(p[FILE]){delete p[FILE]}else{p[FILE]=Date.now()}
    try{localStorage.setItem(KEY,JSON.stringify(p));}catch(e){storageNotice('未保存：浏览器存储不可用；当前页打卡仅本次有效。');}refresh();});});
  refresh();

  var tt=document.getElementById('themeToggle');
  if(tt)tt.addEventListener('click',function(){
    var cur=document.documentElement.getAttribute('data-theme');
    var dark=cur?cur==='dark':matchMedia('(prefers-color-scheme: dark)').matches;
    var next=dark?'light':'dark';
    document.documentElement.setAttribute('data-theme',next);
    try{try{localStorage.setItem('recsys-theme',next);}catch(e){storageNotice('主题已切换；无法保存，关闭页面后可能不保留。');}}catch(e){storageNotice('主题已切换；无法保存，关闭页面后可能不保留。');}});
  var bar=document.getElementById('scrollbar');
  addEventListener('scroll',function(){var h=document.documentElement,
    m=h.scrollHeight-h.clientHeight;bar.style.width=(m>0?(h.scrollTop/m*100):0)+'%';},{passive:true});
})();</script><link rel="stylesheet" href="../assets/code-reader.css"><script src="../assets/code-reader.js"></script><script src="../assets/reader-assist.js"></script><script src="../assets/diagram-reader.js"></script><script src="../assets/visual-blocks.js"></script><script src="../assets/glossary.js"></script><link rel="stylesheet" href="../assets/reading-tasks.css"><script defer src="../assets/reading-tasks.js"></script><link rel="stylesheet" href="../assets/llm-reader.css"><script defer src="../assets/magazine-reading-v1.js"></script></body></html>