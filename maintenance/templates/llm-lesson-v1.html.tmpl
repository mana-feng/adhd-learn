<script>(function(){try{var t=localStorage.getItem('recsys-theme');if(t)document.documentElement.setAttribute('data-theme',t);}catch(e){}})();</script><style>
@font-face{font-family:"CodeCJK";
 src:url("../assets/code-cjk-mono.woff2") format("woff2");
 font-weight:400;font-style:normal;font-display:swap;}

:root{
/* ⭐ 字号阶梯：正文 = 1em（body 18px）。其余一律从这几档取，
   不要再写 .92 / .94 / .95 这种随手值 —— body 18px 下它们相差不到 0.5px，
   分不出来，只会让后来的人不知道该抄哪一个。 */
  --fs-xs:.8em;    /* 角标、方向标签 */
  --fs-sm:.88em;   /* 代码、图注、注解 */
  --fs-md:.93em;   /* 略小于正文：表格、面板、目录 —— 站内最常用 */
  --fs-lg:1.14em;  /* h3 */
  --fs-xl:1.42em;  /* h2 */
  --fs-2xl:1.9em;  /* h1 */
--bg:#faf9f6;--fg:#2a2a33;--muted:#6b6b76;--card:#fff;--border:#e6e2d9;
 --accent:#e8590c;--accent-soft:#fff0e6;--link:#0b6bcb;--quote-bg:#f4f1ea;
 --done:#2f9e44;--danger:#c92a2a;--shadow:0 1px 3px rgba(0,0,0,.07)}
[data-theme="dark"]{--bg:#191a1f;--fg:#e6e4de;--muted:#9a99a2;--card:#22232a;
 --border:#33343d;--accent:#ff8a3d;--accent-soft:#33261c;--link:#6cb2ff;
 --quote-bg:#24252c;--done:#51cf66;--danger:#ff6b6b;--shadow:0 1px 3px rgba(0,0,0,.4)}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){
 --bg:#191a1f;--fg:#e6e4de;--muted:#9a99a2;--card:#22232a;--border:#33343d;
 --accent:#ff8a3d;--accent-soft:#33261c;--link:#6cb2ff;--quote-bg:#24252c;
 --done:#51cf66;--danger:#ff6b6b;--shadow:0 1px 3px rgba(0,0,0,.4)}}
*{box-sizing:border-box}html{scroll-behavior:smooth}
</style>
<link rel="stylesheet" href="../assets/reading/lesson-body-base.css">
<style>
#scrollbar{position:fixed;top:0;left:0;height:4px;background:var(--accent);width:0;z-index:99}
header.site{position:sticky;top:0;background:var(--bg);border-bottom:1px solid var(--border);
 z-index:50;padding:0 16px;opacity:.98}
header.site .inner{max-width:880px;margin:0 auto;display:flex;align-items:center;gap:10px;
 height:52px;font-size:14px}
header.site a{color:var(--fg);text-decoration:none;white-space:nowrap}
header.site a:hover{color:var(--accent)}
header.site .title{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
 color:var(--muted);text-align:center}
header.site button{background:none;border:1px solid var(--border);border-radius:8px;
 color:var(--fg);cursor:pointer;padding:4px 10px;font-size:14px}
header.site button:hover{border-color:var(--accent)}
header.site button.done{background:var(--done);color:#fff;border-color:var(--done)}
</style>
<link rel="stylesheet" href="../assets/reading/lesson-prose-base.css">
<style>
blockquote{margin:1.2em 0;padding:12px 18px;background:var(--quote-bg);
 border-left:4px solid var(--accent);border-radius:0 10px 10px 0}
blockquote p{margin:.4em 0}
ul,ol{padding-left:1.5em}li{margin:.35em 0}
</style>
<link rel="stylesheet" href="../assets/reading/lesson-table-base.css">
<style>
code{font-family:"CodeCJK","Sarasa Mono SC","Cascadia Mono","JetBrains Mono",Consolas,NSimSun,monospace;
 font-size:var(--fs-sm);background:var(--quote-bg);padding:2px 6px;border-radius:5px}
pre{border-radius:12px;padding:16px 18px;overflow-x:auto;
 line-height:1.6;box-shadow:var(--shadow)}
pre code{background:none;padding:0;font-size:var(--fs-sm)}
.codehilite{border-radius:12px;overflow-x:auto;margin:1.2em 0}
.codehilite pre{margin:0;box-shadow:none}
details{background:var(--card);border:1px solid var(--border);border-radius:12px;
 padding:12px 18px;margin:1.2em 0;box-shadow:var(--shadow)}
details summary{cursor:pointer;font-weight:600;color:var(--accent)}
details[open] summary{margin-bottom:.6em}
.toc-box{background:var(--card);border:1px solid var(--border);border-radius:12px;
 padding:10px 18px;margin:1.4em 0;font-size:var(--fs-md)}
.toc-box summary{cursor:pointer;font-weight:600;color:var(--muted)}
.toc-box ul{margin:.5em 0;padding-left:1.3em}.toc-box a{text-decoration:none}
.pagenav{display:flex;gap:14px;margin-top:50px}
.pagenav a{flex:1;padding:16px 18px;background:var(--card);border:1px solid var(--border);
 border-radius:14px;text-decoration:none;color:var(--fg);box-shadow:var(--shadow)}
.pagenav a:hover{border-color:var(--accent)}
.pagenav .dir{font-size:var(--fs-xs);color:var(--muted)}.pagenav .next{text-align:right}
.donebar{margin-top:36px;text-align:center}
.donebar button{font-size:1.05em;padding:12px 34px;border-radius:999px;cursor:pointer;
 border:2px solid var(--accent);background:var(--accent-soft);color:var(--fg);font-weight:600}
.donebar button.done{background:var(--done);border-color:var(--done);color:#fff}
.donebar .hint{font-size:var(--fs-sm);color:var(--muted);margin-top:8px}
.srcbox{background:var(--card);border:1px solid var(--border);border-left:5px solid var(--accent);
 border-radius:0 14px 14px 0;padding:16px 20px;margin:0 0 26px;box-shadow:var(--shadow);font-size:var(--fs-md)}
.srcbox .tag{display:inline-block;background:var(--accent);color:#fff;font-size:var(--fs-xs);
 padding:2px 10px;border-radius:99px;margin-bottom:8px;font-weight:600}
.srcbox dl{margin:0;display:grid;grid-template-columns:auto 1fr;gap:4px 12px}
.srcbox dt{color:var(--muted);white-space:nowrap}
.srcbox dd{margin:0;word-break:break-all}
.srcbox .warn{margin-top:10px;color:var(--muted);font-size:var(--fs-md);border-top:1px dashed var(--border);padding-top:8px}
/* ── ASCII 边框图的替代组件 ──────────────────────────────────
   站里原来用 ┌─┐│└─┘ 画方框。那玩意在窄屏上必然折行错位（中位宽 53 字符、
   19 处超过 60），而且等宽字体下中英混排本来就对不齐 —— 看着永远是歪的。
   下面三个组件覆盖了 71 处边框图里的绝大多数形态，全部：
     · 只用 CSS 变量取色 → 自动跟随深浅色主题
     · 不设固定宽度 → 任何屏宽都不溢出
     · 窄屏自动改成单列堆叠                                       */

/* ① 堆叠面板：原「一个大框 + ├──┤ 横隔成几段」 */
.panels{margin:20px 0;border:1px solid var(--border);border-radius:12px;
 overflow:hidden;background:var(--card);box-shadow:var(--shadow)}
.panels .panel{padding:15px 18px;border-top:1px solid var(--border)}
.panels .panel:first-child{border-top:0}
.panels .ph{font-weight:700;color:var(--accent);line-height:1.55;margin-bottom:9px}
.panels .pl{margin:0;padding:0;list-style:none}
.panels .pl li{position:relative;padding:3px 0 3px 15px;line-height:1.7;font-size:var(--fs-md)}
.panels .pl li::before{content:"";position:absolute;left:2px;top:.88em;width:5px;height:5px;
 border-radius:50%;background:var(--accent);opacity:.45}
.panels .pl b{color:var(--fg);font-weight:600}
.panels .pt{margin-top:10px;background:var(--accent-soft);color:var(--accent);
 border-radius:7px;padding:8px 11px;font-size:var(--fs-md);line-height:1.6}

/* ② 单框卡片：原「一个方框，里面几行」 */
.framecard{margin:18px 0;border:1px solid var(--border);border-radius:12px;
 padding:15px 18px;background:var(--card);box-shadow:var(--shadow)}
.framecard .fh{font-weight:700;color:var(--accent);margin-bottom:9px;line-height:1.55}
.framecard ul{margin:0;padding:0;list-style:none}
.framecard li{position:relative;padding:3px 0 3px 15px;line-height:1.7;font-size:var(--fs-md)}
.framecard li::before{content:"";position:absolute;left:2px;top:.88em;width:5px;height:5px;
 border-radius:50%;background:var(--accent);opacity:.45}
.framecard .fnote{margin-top:10px;color:var(--muted);font-size:var(--fs-sm);line-height:1.6;
 border-top:1px dashed var(--border);padding-top:8px}

/* ③ 流程链：原「几个方框用 → 或 ↓ 串起来」。宽屏横排，窄屏自动竖排 */
.flowchain{display:flex;flex-wrap:wrap;align-items:stretch;gap:0;margin:18px 0}
.flowchain .fstep{flex:1 1 150px;min-width:0;border:1px solid var(--border);border-radius:10px;
 background:var(--card);padding:11px 13px;font-size:var(--fs-md);line-height:1.55}
.flowchain .fstep b{display:block;color:var(--accent);margin-bottom:3px}
.flowchain .fstep span{color:var(--muted);font-size:var(--fs-md)}
.flowchain .farrow{flex:0 0 auto;display:flex;align-items:center;justify-content:center;
 padding:0 9px;color:var(--accent);font-size:var(--fs-lg);opacity:.75}
@media(max-width:600px){
 .flowchain{flex-direction:column}
 .flowchain .fstep{flex:1 1 auto}
 .flowchain .farrow{padding:5px 0;transform:rotate(90deg)}
}

/* 图例样式提到基础样式里：原本由 insert_figs 按需注入，但现在正文里也会
   手写内联 SVG（把拓扑类字符画换掉），那些文件不一定被 insert_figs 碰过。
   insert_figs 里有 `if "figure.dia{" not in c` 的判断，所以不会重复注入。 */
figure.dia{margin:22px 0;padding:0}
figure.dia svg{display:block;width:100%;height:auto;max-width:760px;margin:0 auto}
figure.dia figcaption{text-align:center;color:var(--muted);font-size:var(--fs-sm);
 margin-top:8px;line-height:1.6}
figure.dia .dia-t{font-family:"PingFang SC","Microsoft YaHei",system-ui,sans-serif}
/* 手机端不要把一整张信息图压成几像素的字。图在自己的容器内横向滑动，
   正文仍保持正常宽度；800px 覆盖当前图集中最大的 viewBox 宽度。 */
@media(max-width:640px){
/* ⭐ 块公式也要能自己横向滚动：pre/表格/图都有兜底，只有它没有 —— 一条长公式会把整页撑出横向滚动条 */
.katex-display{overflow-x:auto;overflow-y:hidden;padding:2px 0 6px}
figure.dia{max-width:100%;overflow-x:auto;overflow-y:hidden;padding:0 0 8px;
 -webkit-overflow-scrolling:touch;overscroll-behavior-x:contain}
figure.dia::before{content:"图较宽，可左右滑动查看完整内容";display:block;width:max-content;
 margin:0 0 8px;padding:4px 8px;border-radius:999px;color:var(--muted);font-size:var(--fs-xs);
 background:var(--quote-bg);letter-spacing:.01em}
figure.dia svg{width:800px;min-width:800px;max-width:none;margin:0}
}

.dia-lead{color:var(--muted);font-size:var(--fs-md);margin:14px 0 -6px;line-height:1.65}
.dia-note{color:var(--muted);font-size:var(--fs-sm);margin:-8px 0 16px;line-height:1.65}

.gapmap{margin:18px 0}
.gapmap .lead{color:var(--muted);font-size:var(--fs-md);margin-bottom:14px}
.gaprow{display:grid;grid-template-columns:minmax(120px,1.1fr) minmax(150px,1.5fr) minmax(160px,1.6fr);
 gap:0;align-items:stretch;border:1px solid var(--border);border-radius:14px;overflow:hidden;
 margin-bottom:10px;background:var(--card);box-shadow:var(--shadow)}
.gaprow>div{padding:13px 16px;display:flex;align-items:center;font-size:var(--fs-md);line-height:1.5}
.gaprow .who{font-weight:700;background:var(--quote-bg);color:var(--fg);border-right:1px solid var(--border)}
.gaprow .has{color:var(--fg);border-right:1px dashed var(--border)}
.gaprow .miss{color:var(--danger,#e5534b);font-weight:600}
.gaprow .miss::before{content:"缺 ";opacity:.65;font-weight:400}
.gapdown{text-align:center;font-size:1.6em;color:var(--accent);margin:4px 0 10px;line-height:1}
.gapfill{border:2px solid var(--accent);border-radius:16px;padding:18px 20px;background:var(--card);
 box-shadow:var(--shadow)}
.gapfill b{color:var(--accent);display:block;margin-bottom:10px;font-size:1.05em}
.gapfill ul{margin:0;padding-left:1.1em;columns:2;column-gap:26px}
.gapfill li{margin:.28em 0;font-size:var(--fs-md);break-inside:avoid}
@media(max-width:640px){
 .gaprow{grid-template-columns:1fr}
 .gaprow .who{border-right:none;border-bottom:1px solid var(--border)}
 .gaprow .has{border-right:none;border-bottom:1px dashed var(--border)}
 .gapfill ul{columns:1}
}
::selection{background:var(--accent);color:#fff}
@media(max-width:640px){body{font-size:16px}header.site .prevnext{display:none}}

pre { line-height: 125%; }
td.linenos .normal { padding-left: 5px; padding-right: 5px; }
span.linenos { padding-left: 5px; padding-right: 5px; }
td.linenos .special { padding-left: 5px; padding-right: 5px; }
span.linenos.special { padding-left: 5px; padding-right: 5px; }
.codehilite .ge { font-style: italic; } /* Generic.Emph */
.codehilite .ges { font-weight: bold; font-style: italic; } /* Generic.EmphStrong */
.codehilite .gp { font-weight: bold; } /* Generic.Prompt */
.codehilite .gs { font-weight: bold; } /* Generic.Strong */
</style><link rel="stylesheet" href="../assets/vendor/katex/katex.min.css">
